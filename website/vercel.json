{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Content-Type", "value": "text/html; charset=utf-8" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Content-Type", "value": "text/css; charset=utf-8" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/javascript; charset=utf-8" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/javascript; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/(favicon.svg)",
      "headers": [
        { "key": "Content-Type", "value": "image/svg+xml" },
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/index.html" },
    { "source": "/how-it-works", "destination": "/index.html" },
    { "source": "/faq", "destination": "/index.html" },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/weather", "destination": "/app.html" },
    { "source": "/weather-downscaling", "destination": "/app.html" },
    { "source": "/map", "destination": "/app.html" },
    { "source": "/validation", "destination": "/app.html" },
    { "source": "/advisory", "destination": "/app.html" },
    { "source": "/alerts", "destination": "/app.html" },
    { "source": "/provenance", "destination": "/app.html" },
    { "source": "/data", "destination": "/app.html" },
    { "source": "/methodology", "destination": "/app.html" },
    { "source": "/login", "destination": "/login.html" }
  ]
}
