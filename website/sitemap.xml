<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap for Panchayat Weather Intelligence.

  The production origin is not pinned in this repository, so <loc> entries use
  root-relative URLs. Root-relative entries are accepted by Google and Bing (they
  resolve them against the host the sitemap is served from) and keep this file
  correct on every Vercel preview and production domain with no build step.

  If you prefer absolute URLs once the final domain is known, set each <loc> to
  https://YOUR-DOMAIN/... — the same single place also documents the canonical/OG
  origin: js/site-config.js (window.PWI_CONFIG.SITE_URL).
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>/</loc>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>/app</loc>
    <changefreq>weekly</changefreq>
    <priority>0.9</priority>
  </url>
  <url>
    <loc>/map</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>/advisory</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>/how-it-works</loc>
    <changefreq>monthly</changefreq>
    <priority>0.7</priority>
  </url>
  <url>
    <loc>/about</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>/methodology</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>/data</loc>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  <url>
    <loc>/login</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
