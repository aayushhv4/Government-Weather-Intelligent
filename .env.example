[TEMPLATE]
# Panchayat Weather Intelligence — environment variable names (never commit real values)

# ------------------------------------------------------------------
# Panchayat Weather Intelligence backend service (backend/weather)
# ------------------------------------------------------------------

# Allowed browser origins for the FastAPI downscaling service.
# Default is '*' for demo; set the deployed frontend origin in production.
WEATHER_CORS_ORIGINS=

# Supabase persistence for the five weather tables
# (panchayats, weather_inputs, downscaled_forecasts, validation_runs, advisories)
# SUPABASE_SERVICE_ROLE_KEY is read ONLY by the Python service (server-side).
# Never expose it to browser JavaScript.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------
# Frontend browser globals (set in index.html / app.html <head>)
# These are not real environment variables — they are JS globals set
# via a <script> block before the application scripts load.
# ------------------------------------------------------------------
# window.PWI_CONFIG.SITE_URL = 'https://your-deployment-domain'
# window.PWI_CONFIG.AI_ENDPOINT = 'https://your-ai-proxy'
# window.PWI_CONFIG.SUPABASE_URL = '...'
# window.PWI_CONFIG.SUPABASE_ANON_KEY = '...'  (browser-safe anon key only)

# ------------------------------------------------------------------
# Test runner
# ------------------------------------------------------------------
# Path to Chrome/Edge executable for headless Puppeteer tests.
# Defaults to the standard Chrome install location if not set.
CHROME_PATH=
