{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/website/index.html"
    },
    {
      "source": "/login",
      "destination": "/website/login.html"
    },
    {
      "source": "/login.html",
      "destination": "/website/login.html"
    },
    {
      "source": "/app",
      "destination": "/website/index.html"
    },
    {
      "source": "/weather-downscaling",
      "destination": "/website/index.html"
    },
    {
      "source": "/map",
      "destination": "/website/index.html"
    },
    {
      "source": "/validation",
      "destination": "/website/index.html"
    },
    {
      "source": "/advisory",
      "destination": "/website/index.html"
    },
    {
      "source": "/alerts",
      "destination": "/website/index.html"
    },
    {
      "source": "/provenance",
      "destination": "/website/index.html"
    },
    {
      "source": "/methodology",
      "destination": "/website/index.html"
    },

    {
      "source": "/css/:path*",
      "destination": "/website/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/website/js/:path*"
    },
    {
      "source": "/data/:path*",
      "destination": "/website/data/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/website/assets/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },

    {
      "source": "/weather-intel",
      "destination": "/website/index.html"
    },
    {
      "source": "/weather-intel/:path*",
      "destination": "/website/:path*"
    },
    {
      "source": "/app.css",
      "destination": "/website/css/website.css"
    },
    {
      "source": "/app.js",
      "destination": "/website/js/website.js"
    },
    {
      "source": "/demo-bundle.js",
      "destination": "/website/data/weather-bundle.js"
    },
    {
      "source": "/weather-bundle.js",
      "destination": "/website/data/weather-bundle.js"
    }
  ]
}
