{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Content-Type", "value": "text/html; charset=utf-8" }]
    },
    {
      "source": "/(css|js|data)/:path*",
      "headers": [{ "key": "Content-Type", "value": "charset=utf-8" }]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/frontend/weather-intel/product/index.html" },
    { "source": "/index.html", "destination": "/frontend/weather-intel/product/index.html" },

    { "source": "/about", "destination": "/frontend/weather-intel/product/index.html" },
    { "source": "/how-it-works", "destination": "/frontend/weather-intel/product/index.html" },
    { "source": "/faq", "destination": "/frontend/weather-intel/product/index.html" },

    { "source": "/app", "destination": "/frontend/weather-intel/product/app.html" },
    { "source": "/app.html", "destination": "/frontend/weather-intel/product/app.html" },
    { "source": "/weather", "destination": "/frontend/weather-intel/product/app.html" },
    { "source": "/weather-downscaling", "destination": "/frontend/weather-intel/product/app.html" },
    { "source": "/map", "destination": "/frontend/weather-intel/product/app.html" },
    { "source": "/validation", "destination": "/frontend/weather-intel/product/app.html" },
    { "source": "/advisory", "destination": "/frontend/weather-intel/product/app.html" },
    { "source": "/alerts", "destination": "/frontend/weather-intel/product/app.html" },
    { "source": "/provenance", "destination": "/frontend/weather-intel/product/app.html" },
    { "source": "/data", "destination": "/frontend/weather-intel/product/app.html" },
    { "source": "/methodology", "destination": "/frontend/weather-intel/product/app.html" },

    { "source": "/login", "destination": "/frontend/weather-intel/product/login.html" },
    { "source": "/login.html", "destination": "/frontend/weather-intel/product/login.html" },

    { "source": "/favicon.svg", "destination": "/frontend/weather-intel/product/favicon.svg" },
    { "source": "/robots.txt", "destination": "/frontend/weather-intel/product/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },

    { "source": "/css/:path*", "destination": "/frontend/weather-intel/product/css/:path*" },
    { "source": "/js/:path*", "destination": "/frontend/weather-intel/product/js/:path*" },
    { "source": "/data/:path*", "destination": "/frontend/weather-intel/product/data/:path*" },
    { "source": "/assets/:path*", "destination": "/frontend/weather-intel/product/assets/:path*" },

    { "source": "/api/:path*", "destination": "/api/:path*" }
  ]
}
