{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Content-Type", "value": "text/html; charset=utf-8" }]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Content-Type", "value": "text/css; charset=utf-8" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/javascript; charset=utf-8" }]
    },
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Content-Type", "value": "application/javascript; charset=utf-8" }]
    },
    {
      "source": "/robots.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        { "key": "Content-Type", "value": "image/svg+xml" },
        { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/", "destination": "/website/index.html" },
    { "source": "/index.html", "destination": "/website/index.html" },
    { "source": "/about", "destination": "/website/index.html" },
    { "source": "/how-it-works", "destination": "/website/index.html" },
    { "source": "/faq", "destination": "/website/index.html" },
    { "source": "/app", "destination": "/website/app.html" },
    { "source": "/app.html", "destination": "/website/app.html" },
    { "source": "/weather", "destination": "/website/app.html" },
    { "source": "/weather-downscaling", "destination": "/website/app.html" },
    { "source": "/map", "destination": "/website/app.html" },
    { "source": "/validation", "destination": "/website/app.html" },
    { "source": "/advisory", "destination": "/website/app.html" },
    { "source": "/alerts", "destination": "/website/app.html" },
    { "source": "/provenance", "destination": "/website/app.html" },
    { "source": "/data", "destination": "/website/app.html" },
    { "source": "/methodology", "destination": "/website/app.html" },
    { "source": "/login", "destination": "/website/login.html" },
    { "source": "/login.html", "destination": "/website/login.html" },
    { "source": "/robots.txt", "destination": "/website/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/website/sitemap.xml" },
    { "source": "/favicon.svg", "destination": "/website/favicon.svg" },
    { "source": "/css/:path*", "destination": "/website/css/:path*" },
    { "source": "/js/:path*", "destination": "/website/js/:path*" },
    { "source": "/data/:path*", "destination": "/website/data/:path*" },
    { "source": "/assets/:path*", "destination": "/website/assets/:path*" }
  ]
}
